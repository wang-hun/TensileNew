<Window x:Class="TensileNeW.TwoStageSpeedDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="720" Height="620" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Background="{DynamicResource AppSurfaceBackgroundBrush}" FontFamily="Microsoft YaHei">
 <Border Padding="20" Background="{DynamicResource AppSurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppLayoutBorderBrush}" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="二段速配置" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppMetricNameForegroundBrush}"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10"><TextBlock Text="配方名称" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource AppMetricNameForegroundBrush}"/><TextBox x:Name="RecipeNameBox" Width="300" Height="32"/></StackPanel>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <GroupBox Header="一段速" Margin="0,0,8,0"><Grid x:Name="FirstGrid" Margin="10"/></GroupBox>
    <GroupBox Header="二段速" Grid.Column="1" Margin="8,0,0,0"><Grid x:Name="SecondGrid" Margin="10"/></GroupBox>
   </Grid>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
    <TextBlock x:Name="ErrorTextBlock" Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="Collapsed"/>
    <Button Style="{StaticResource ButtonPrimary}" Content="保存" Width="90" Height="34" Margin="0,0,8,0" Click="Save_Click"/>
    <Button Content="取消" Width="90" Height="34" Click="Cancel_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>