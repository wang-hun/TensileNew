<Window x:Class="EcsInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="ECS Installer"
        Width="620"
        Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Closing="Window_Closing"
        Icon="Assets/logo.ico">
    <Border Background="#FFF8F2FB"
            BorderBrush="#FFE3D1EA"
            BorderThickness="1"
            CornerRadius="10"
            MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown">
        <Grid>
            <ContentControl x:Name="PageHost" />

            <Button x:Name="CloseButton"
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Background="#FFE94B5F"
                    Foreground="White"
                    BorderThickness="0"
                    Panel.ZIndex="10"
                    Click="Close_Click">
                <iconPacks:PackIconPicolIcons Kind="Cancel"
                                               Width="18"
                                               Height="18" />
            </Button>
        </Grid>
    </Border>
</Window>
