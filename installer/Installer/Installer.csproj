<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ECS-Installer</AssemblyName>
    <RootNamespace>EcsInstaller</RootNamespace>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\Assets\logo.ico</ApplicationIcon>
    <Version>1.1.6.2606</Version>
    <AssemblyVersion>1.1.6.2606</AssemblyVersion>
    <FileVersion>1.1.6.2606</FileVersion>
    <InformationalVersion>V1.1.6.2606</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InstallerPayloadZip Condition="'$(InstallerPayloadZip)' == ''"></InstallerPayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Resource Include="..\..\Assets\logo.ico" Link="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(InstallerPayloadZip)' != '' and Exists('$(InstallerPayloadZip)')">
    <EmbeddedResource Include="$(InstallerPayloadZip)" LogicalName="EcsInstaller.Payload.payload.zip" />
  </ItemGroup>

</Project>
