<UserControl x:Class="EcsInstaller.DeployingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <UserControl.Resources>
        <PathGeometry x:Key="LineLogoGeometry">
            <PathFigure StartPoint="42.2,9.5" IsClosed="False">
                <LineSegment Point="11,27.5" />
                <LineSegment Point="11,72.5" />
                <LineSegment Point="50,95" />
                <LineSegment Point="89,72.5" />
                <LineSegment Point="50,50" />
                <LineSegment Point="50,45" />
                <LineSegment Point="50,55" />
                <LineSegment Point="50,50" />
                <LineSegment Point="89,27.5" />
                <LineSegment Point="57.8,9.5" />
            </PathFigure>
        </PathGeometry>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="82" Height="82" Margin="0,0,0,22">
            <hc:AnimationPath Data="{StaticResource LineLogoGeometry}"
                              Duration="00:00:01.4"
                              Stretch="Uniform"
                              StrokeThickness="4"
                              Stroke="#FF8B4AB8"
                              StrokeStartLineCap="Flat"
                              StrokeEndLineCap="Flat" />
        </Grid>
        <TextBlock Text="正在部署中请稍后……"
                   FontSize="22"
                   Foreground="#FF382244"
                   TextAlignment="Center" />
        <TextBlock x:Name="ProgressTextBlock"
                   Text="正在准备文件"
                   FontSize="14"
                   Foreground="#FF6E557B"
                   Margin="0,14,0,0"
                   TextAlignment="Center" />
    </StackPanel>
</UserControl>
