<UserControl x:Class="EcsInstaller.DonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <PathGeometry x:Key="LineLogoGeometry">
            <PathFigure StartPoint="42.2,9.5" IsClosed="False">
                <LineSegment Point="11,27.5" />
                <LineSegment Point="11,72.5" />
                <LineSegment Point="50,95" />
                <LineSegment Point="89,72.5" />
                <LineSegment Point="50,50" />
                <LineSegment Point="50,45" />
                <LineSegment Point="50,55" />
                <LineSegment Point="50,50" />
                <LineSegment Point="89,27.5" />
                <LineSegment Point="57.8,9.5" />
            </PathFigure>
        </PathGeometry>
    </UserControl.Resources>

    <Grid Margin="38,30,38,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,12,0,0">
            <Grid Width="88" Height="88" Margin="0,0,0,22">
                <Path Data="{StaticResource LineLogoGeometry}"
                      Stretch="Uniform"
                      Stroke="#FF8B4AB8"
                      StrokeThickness="4"
                      StrokeStartLineCap="Flat"
                      StrokeEndLineCap="Flat" />
            </Grid>
            <TextBlock Text="部署成功"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#FF382244"
                       TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Width="138"
                    Height="46"
                    Content="关闭"
                    Click="Close_Click"
                    Margin="0,0,18,0"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="#FFE94B5F"
                    Foreground="White"
                    BorderThickness="0" />
            <Button Width="178"
                    Height="46"
                    Content="启动 ECS"
                    Click="Launch_Click"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Background="#FF8B4AB8"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>
