              <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Background="{DynamicResource AppSurfaceBackgroundBrush}" BorderBrush="#D8DBE3" BorderThickness="0,0,0,1">
                <TextBlock Text="标定" Style="{StaticResource SectionTitleTextStyle}" />
              </Border>
              <Grid Grid.Row="1" Margin="30,10" Background="{DynamicResource AppSidebarBackgroundBrush}" TextElement.Foreground="{DynamicResource AppSidebarLabelForegroundBrush}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Grid.Row="1" Style="{StaticResource ButtonPrimary}" Width="220" Height="48" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Calibration_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="Disc" Width="20" Height="20" Margin="0,0,8,0" />
                    <TextBlock Text="开始传感器归零" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <TextBlock Grid.Row="2" Text="标定前确定设备空载且不处于运行状态。" FontSize="16" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="标定状态" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <iconPacks:PackIconBootstrapIcons Style="{StaticResource StatusIconStyle}" Tag="{Binding Source={x:Static local:MainWindow.CalibrationStateVariable}, Path=CurrentValue}" />
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <!-- ==================== VARIABLES PAGE ==================== -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Variables">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="White" Margin="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="55" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#F5F6F8" BorderBrush="#D8DBE3" BorderThickness="0,0,0,1">
              <Grid>
                <TextBlock Text="变量实时显示" Style="{StaticResource SectionTitleTextStyle}" />
                <Button Style="{StaticResource ButtonPrimary}" Width="150" Height="36" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Click="OpenVariablesWindow_Click">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconBootstrapIcons Kind="BoxArrowUpRight" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="新窗口打开" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding PlcVariables}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="300" />
                <DataGridTextColumn Header="变量地址" Binding="{Binding Address}" Width="160" />
                <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="160" />
                <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
      <!-- ==================== COLOR SCHEMES PAGE ==================== -->
      <Grid Grid.Row="1" Background="{DynamicResource AppSidebarBackgroundBrush}">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage}" Value="ColorSchemes">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="{DynamicResource AppSidebarBackgroundBrush}" Margin="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="55" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource AppSurfaceBackgroundBrush}" BorderBrush="#D8DBE3" BorderThickness="0,0,0,1">
              <TextBlock Text="配色方案" Style="{StaticResource SectionTitleTextStyle}" />
            </Border>
            <ListBox Grid.Row="1" ItemsSource="{Binding ColorSchemes}" Margin="16" BorderThickness="0" Background="{DynamicResource AppSidebarBackgroundBrush}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#D8DBE3" BorderThickness="1" Background="{DynamicResource AppSurfaceBackgroundBrush}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="应用" Style="{StaticResource ButtonPrimary}" Height="36" FontSize="15" Click="ApplyColorScheme_Click" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </hc:DialogContainer>
</Window>
