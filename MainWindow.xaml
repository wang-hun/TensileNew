<Window x:Class="TensileNeW.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" xmlns:local="clr-namespace:TensileNeW" xmlns:models="clr-namespace:TensileNeW.Models" Title="ECS" Width="1800" Height="1000" WindowState="Maximized" Background="#F5F6F8" FontFamily="Microsoft YaHei" Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.Resources>
    <local:BoolStringToBrushConverter x:Key="BoolBrush" />
    <local:FloatFormatConverter x:Key="FloatFormat" />
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
      <Setter Property="Height" Value="55" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="Margin" Value="0,6,10,6" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#606266" />
      <Setter Property="Background" Value="#F5F6F8" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="HomeNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
          <Setter Property="Foreground" Value="#1677FF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
          <Setter Property="Foreground" Value="#1677FF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="VariablesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Variables">
          <Setter Property="Foreground" Value="#1677FF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="IndicatorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
      <Setter Property="Background" Value="#0F4C97" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0F4C97" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="#1677FF" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="BorderBrush" Value="#1677FF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DeleteRecipeButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
      <Setter Property="IsEnabled" Value="True" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRecipe}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="Border">
      <Setter Property="Background" Value="#F5F6F8" />
      <Setter Property="BorderBrush" Value="#D8DBE3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#404040" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MetricNameStyle" TargetType="TextBlock">
      <Setter Property="Background" Value="#F2F2F2" />
      <Setter Property="Foreground" Value="#696969" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="8,0,12,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="LineHeight" Value="48" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="CompactMetricNameStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricNameStyle}">
      <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="Black" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#696969" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="StatusIconStyle" TargetType="iconPacks:PackIconBootstrapIcons">
      <Setter Property="Kind" Value="PatchMinusFill" />
      <Setter Property="Foreground" Value="#909399" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Kind" Value="PatchCheck" />
          <Setter Property="Foreground" Value="#2FB344" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeaderReconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
      <Setter Property="Width" Value="114" />
      <Setter Property="Height" Value="35" />
      <Setter Property="Margin" Value="8,0,2,0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#1677FF" />
      <Setter Property="ToolTip" Value="重新连接设备主机" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#1677FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="HoldActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
      <Setter Property="Background" Value="#D97706" />
      <Setter Property="BorderBrush" Value="#B45309" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#B45309" />
          <Setter Property="BorderBrush" Value="#92400E" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <hc:DialogContainer>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.RowSpan="2" hc:Growl.Token="MainGrowl" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,16,16,0" Width="360" Panel.ZIndex="9999" />
      <!-- Header -->
      <Border Background="#F5F6F8" BorderBrush="#D8DBE3" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image x:Name="LogoImage" Source="pack://application:,,,/GB-LOGO.png" Stretch="Uniform" Margin="0,0,30,0" MouseLeftButtonDown="LogoImage_MouseLeftButtonDown" />
          <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="128" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="128" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource HomeNavButtonStyle}" Click="Home_Click">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconBoxIcons2 Kind="RegularHome" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="主页" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource SettingsNavButtonStyle}" Click="Settings_Click">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconCircumIcons Kind="Settings" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="设置" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button x:Name="VariablesButton" Grid.Column="2" Style="{StaticResource VariablesNavButtonStyle}" Visibility="Hidden" Click="Variables_Click">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconBootstrapIcons Kind="CardChecklist" Width="26" Height="26" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="变量" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button x:Name="ReconnectButton" Grid.Column="4" Style="{StaticResource HeaderReconnectButtonStyle}" Click="Reconnect_Click">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconIonicons Kind="GitNetworkiOS" Width="18" Height="18" Margin="0,0,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="重新连接" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="5" Text="联机状态" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid Width="29" Height="29">
                <iconPacks:PackIconVaadinIcons Kind="GlobeWire" Width="29" Height="29" Foreground="#2FB344" Tag="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState}">
                  <iconPacks:PackIconVaadinIcons.Style>
                    <Style TargetType="iconPacks:PackIconVaadinIcons">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="true">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </iconPacks:PackIconVaadinIcons.Style>
                </iconPacks:PackIconVaadinIcons>
                <iconPacks:PackIconPhosphorIcons Kind="GlobeX" Width="29" Height="29" Foreground="#E03131" Tag="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState}">
                  <iconPacks:PackIconPhosphorIcons.Style>
                    <Style TargetType="iconPacks:PackIconPhosphorIcons">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="true">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </iconPacks:PackIconPhosphorIcons.Style>
                </iconPacks:PackIconPhosphorIcons>
              </Grid>
              <TextBlock Margin="6,0,12,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="连接失败" />
                    <Setter Property="Foreground" Value="#E03131" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState}" Value="true">
                        <Setter Property="Text" Value="已连接" />
                        <Setter Property="Foreground" Value="#2FB344" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
      <!-- ==================== HOME PAGE ==================== -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="342" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="374" />
        </Grid.ColumnDefinitions>
        <!-- Left side panel: current trial -->
        <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="White">
          <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Grid MinHeight="415">
              <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="60" />
                <RowDefinition Height="60" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="2*" />
              </Grid.RowDefinitions>
              <!-- 当前试验 title -->
              <Border Style="{StaticResource SectionTitleStyle}" Grid.Row="0" Height="55">
                <TextBlock Text="当前试验" Style="{StaticResource SectionTitleTextStyle}" />
              </Border>
              <!-- Recipe + SN row -->
              <Grid Grid.Row="1" Margin="8,4" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前配置：" FontSize="15" Foreground="#404040" VerticalAlignment="Center" Margin="18,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="RecipeName" Width="175" Height="34" FontSize="16" Margin="4,0" />
              </Grid>
              <Grid Grid.Row="2" Margin="8,4" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="试验序列号：" FontSize="15" Foreground="#404040" VerticalAlignment="Center" Margin="18,0,8,0" />
                <TextBox Grid.Column="1" Text="{Binding TrialSerialNumber, UpdateSourceTrigger=PropertyChanged}" Width="175" Height="34" FontSize="16" VerticalContentAlignment="Center" Margin="4,0" />
              </Grid>
              <!-- real-time readouts -->
              <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="运行状态" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="拉伸时间" />
                <Grid Grid.Row="1" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.TimeVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="S" />
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="最大拉伸力" />
                <Grid Grid.Row="2" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.MaxForceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="拉伸位移" />
                <Grid Grid.Row="3" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealDistanceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="mm" />
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="有效拉伸位移" />
                <Grid Grid.Row="4" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ValidDistanceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="mm" />
                </Grid>
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="主推力" />
                <Grid Grid.Row="5" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.BeginForceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="预设冲程压边力" />
                <Grid Grid.Row="6" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.PreSetForceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
                <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="实时拉伸速度" />
                <Grid Grid.Row="7" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealSpeedVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="mm/s" />
                </Grid>
                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="实时拉伸力" />
                <Grid Grid.Row="8" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealForceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
                <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="实时压边力" />
                <Grid Grid.Row="9" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealPressVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
              </Grid>
              <!-- 试验参数 sub-panel -->
              <Grid Grid.Row="4" />
              <Grid Grid.Row="5">
                <Grid.RowDefinitions>
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                  <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="试验参数" FontSize="16" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="冲程压边力设定" />
                <Grid Grid.Row="1" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.PreSetForceVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="闭环压边力设定" />
                <Grid Grid.Row="2" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ClosedLoopVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="KN" />
                </Grid>
                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="停机延时设定" />
                <Grid Grid.Row="3" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ShutdownDelayVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="(10ms)" />
                </Grid>
                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="停机比例设定" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ShutdownRatioVariable}}" Margin="0,0,8,0" />
                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource CompactMetricNameStyle}" Text="速度设定" />
                <Grid Grid.Row="5" Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.SpeedVariable}}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MetricUnitStyle}" Text="mm/s" />
                </Grid>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Border>
        <!-- Middle: chart + action buttons -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="260" />
          </Grid.RowDefinitions>
          <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="White" Margin="1">
            <Grid>
              <sp:WpfPlot x:Name="LoadPlot" Margin="8" />
              <CheckBox x:Name="AutoTrackLatestPointCheckBox"
                        Content="自动跟踪最新点"
                        IsChecked="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16,12,0,0"
                        Panel.ZIndex="20"
                        FontSize="14"
                        Foreground="#404040"
                        Checked="AutoTrackLatestPointCheckBox_Changed"
                        Unchecked="AutoTrackLatestPointCheckBox_Changed" />
              <Button x:Name="ChartHintButton" Width="31.5" Height="31.5" Margin="0,2.75,8,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="20" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" ToolTip="显示/隐藏曲线图操作提示" Click="ChartHintButton_Click">
                <Grid>
