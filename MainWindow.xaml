<Window x:Class="TensileNeW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:TensileNeW"
        xmlns:models="clr-namespace:TensileNeW.Models"
        Title="ECS" Width="1800" Height="1000" WindowState="Maximized"
        Background="#F5F6F8" FontFamily="Microsoft YaHei"
        Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources>
        <local:BoolStringToBrushConverter x:Key="BoolBrush" />
        <local:FloatFormatConverter x:Key="FloatFormat" />
        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
            <Setter Property="Height" Value="92" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,10,12,10" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="Background" Value="#F5F6F8" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="18,8" />
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style x:Key="MetricNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#606266" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="113" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#F5F6F8" BorderBrush="#D8DBE3" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/GB-LOGO.png" Stretch="Uniform" Margin="0,0,2,0" />
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource NavButtonStyle}" Content="主页" Click="Home_Click" />
                    <Button Grid.Column="1" Style="{StaticResource NavButtonStyle}" Content="设置" Click="Settings_Click" />
                    <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" Content="变量" Click="Variables_Click" />
                    <TextBlock Grid.Column="4" Text="联机状态" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <hc:Badge Grid.Column="5" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState, Converter={StaticResource BoolBrush}}"
                              BorderBrush="#909399" BorderThickness="1" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="342" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="374" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="55" />
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="配方信息" Foreground="#111827" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="RecipeName" FontSize="18" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentSn}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" />
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="2" Rows="13">
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="拉伸时间" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.TimeVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="最大拉伸力" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.MaxForceVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="实时拉伸位移" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealDistanceVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="有效拉伸位移" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ValidDistanceVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="主推力" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.BeginForceVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="冲程压边力设定" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.PreSetForceVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="实时拉伸速度" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealSpeedVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="实时拉伸力" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealForceVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="实时压边力" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.RealPressVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="闭环压边力设定" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ClosedLoopVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="停机延时设定" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ShutdownDelayVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="停机比例设定" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.ShutdownRatioVariable}}" />
                        <TextBlock Style="{StaticResource MetricNameStyle}" Text="速度设定" />
                        <TextBlock Style="{StaticResource MetricValueStyle}" Text="{Binding Path=CurrentValue, Source={x:Static local:MainWindow.SpeedVariable}}" />
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="250" />
                </Grid.RowDefinitions>
                <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="White" Margin="1">
                    <sp:WpfPlot x:Name="LoadPlot" Margin="8" />
                </Border>
                <UniformGrid Grid.Row="1" Columns="4" Rows="2" Background="White">
                    <Button Style="{StaticResource ActionButtonStyle}" Content="压边" Click="StartPress_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Content="释放压边" Click="ReleasePress_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Content="启动拉伸" Click="StartTensile_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Content="释放拉伸" Click="ReleaseTensile_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Content="冲程压边" PreviewMouseDown="ClosePress_Down" PreviewMouseUp="ClosePress_Up" />
                    <Button Style="{StaticResource ButtonDanger}" Height="66" Margin="18,8" FontSize="20" Content="停止动作" Click="Stop_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Content="数据重置" Click="Reset_Click" />
                    <Button Style="{StaticResource ActionButtonStyle}" Content="弹料" PreviewMouseDown="Tanliao_Down" PreviewMouseUp="Tanliao_Up" />
                </UniformGrid>
            </Grid>

            <Grid Grid.Column="2" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="98" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Style="{StaticResource ButtonPrimary}" Content="保存数据" Margin="30,10" FontSize="22" Click="SaveData_Click" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding LoadItems}" AutoGenerateColumns="False" IsReadOnly="True" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="70" />
                        <DataGridTextColumn Header="位移" Binding="{Binding RealDistance, Converter={StaticResource FloatFormat}}" Width="80" />
                        <DataGridTextColumn Header="载荷" Binding="{Binding RealForce, Converter={StaticResource FloatFormat}}" Width="80" />
                        <DataGridTextColumn Header="压边" Binding="{Binding RealPress, Converter={StaticResource FloatFormat}}" Width="80" />
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="RecipeName" FontSize="20" Margin="16" />
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="配方名称" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Column="1" Text="{Binding SelectedRecipe.RecipeName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="1" Text="冲程压边力设定" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedRecipe.StrokeStampingForce, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="2" Text="闭环压边力设定" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRecipe.ClosedLoopStampingForce, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="3" Text="停机延时设定" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedRecipe.ShutdownDelay, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="4" Text="停机比例设定" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRecipe.ShutdownRatio, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="5" Text="速度设定" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRecipe.Speed, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="6" Text="PLC IP" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Setting.PLC_IP, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="7" Text="Excel目录" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Setting.ExcelFolderPath, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <TextBlock Grid.Row="8" Text="语言" FontSize="20" VerticalAlignment="Center" Margin="0,10" />
                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Setting.Language, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Margin="0,10" />
                <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource ButtonInfo}" Content="新增配方" Width="140" Height="48" Margin="0,0,12,0" Click="AddRecipe_Click" />
                    <Button Style="{StaticResource ButtonDanger}" Content="删除配方" Width="140" Height="48" Margin="0,0,12,0" Click="DeleteRecipe_Click" />
                    <Button Style="{StaticResource ButtonPrimary}" Content="写入配方" Width="140" Height="48" Margin="0,0,12,0" Click="WriteRecipe_Click" />
                    <Button Style="{StaticResource ButtonPrimary}" Content="传感器标零" Width="140" Height="48" Margin="0,0,12,0" Click="Calibration_Click" />
                    <Button Style="{StaticResource ButtonSuccess}" Content="保存设置" Width="140" Height="48" Click="SaveSettings_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentPage}" Value="Variables">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <DataGrid ItemsSource="{Binding PlcVariables}" AutoGenerateColumns="False" IsReadOnly="True" Margin="16">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="300" />
                    <DataGridTextColumn Header="变量地址" Binding="{Binding Address}" Width="160" />
                    <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="160" />
                    <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid>
</Window>
