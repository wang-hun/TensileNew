<Window x:Class="TensileNeW.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:hc="https://handyorg.github.io/handycontrol" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF" xmlns:local="clr-namespace:TensileNeW" xmlns:models="clr-namespace:TensileNeW.Models" xmlns:controls="clr-namespace:TensileNeW.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="ECS" Width="1800" Height="1000" WindowState="Maximized" Background="#F5F6F8" FontFamily="Microsoft YaHei" Closing="Window_Closing" Loaded="Window_Loaded">
  <Window.Resources>
    <local:BoolStringToBrushConverter x:Key="BoolBrush" />
    <local:FloatFormatConverter x:Key="FloatFormat" />
    <HierarchicalDataTemplate DataType="{x:Type models:HelpNavigationItem}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <iconPacks:PackIconJamIcons x:Name="HelpRootBookIcon" Kind="Book" Width="20" Height="20" Margin="0,0,7,0" Foreground="#1D4ED8" Visibility="Collapsed" />
        <hc:RunningBlock x:Name="HelpNavigationTitle" Content="{Binding Title}" AutoRun="True" Duration="0:0:18" />
      </StackPanel>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRoot}" Value="True">
          <Setter TargetName="HelpRootBookIcon" Property="Visibility" Value="Visible" />
          <Setter TargetName="HelpNavigationTitle" Property="Foreground" Value="#1D4ED8" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
          <Setter TargetName="HelpRootBookIcon" Property="Foreground" Value="#D03050" />
          <Setter TargetName="HelpNavigationTitle" Property="Foreground" Value="#D03050" />
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="39" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AppNavForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppNavBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="HomeNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
          <Setter Property="Foreground" Value="{DynamicResource AppNavSelectedForegroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SettingsNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Settings">
          <Setter Property="Foreground" Value="{DynamicResource AppNavSelectedForegroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="VariablesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Variables">
          <Setter Property="Foreground" Value="{DynamicResource AppNavSelectedForegroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HelpNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="Help">
          <Setter Property="Foreground" Value="{DynamicResource AppNavSelectedForegroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ColorSchemesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding CurrentPage}" Value="ColorSchemes">
          <Setter Property="Foreground" Value="{DynamicResource AppNavSelectedForegroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RecipeListBoxItemStyle" TargetType="ListBoxItem">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBackgroundBrush}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackgroundBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSurfaceBackgroundBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="IndicatorActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
      <Setter Property="Background" Value="#0F4C97" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#0F4C97" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="#1677FF" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="BorderBrush" Value="#1677FF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DeleteRecipeButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonDanger}">
      <Setter Property="IsEnabled" Value="True" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding SelectedRecipe}" Value="{x:Null}">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
        <DataTrigger Binding="{Binding SelectedRecipe.IsBuiltInRecipe}" Value="True">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="#D8DBE3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="44" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#404040" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MetricNameStyle" TargetType="TextBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppMetricNameForegroundBrush}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="8,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="LineHeight" Value="48" />
      <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <Style x:Key="CompactMetricNameStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricNameStyle}">
      <Setter Property="LineHeight" Value="30" />
    </Style>
    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AppMetricValueForegroundBrush}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Margin" Value="8,0,10,0" />
    </Style>
    <Style x:Key="SevenSegmentMetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricValueStyle}">
      <Setter Property="FontFamily" Value="{DynamicResource SevenSegmentFontFamily}" />
      <Setter Property="FontSize" Value="34" />
    </Style>
    <Style x:Key="MetricUnitStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#696969" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Width" Value="48" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="MetricValueCellStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="OuterShadowBorderStyle" TargetType="Border">
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.20" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CurrentTrialContentBorderStyle" TargetType="Border" BasedOn="{StaticResource OuterShadowBorderStyle}">
      <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style x:Key="HomeInnerShadowPanelStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="LargeMetricGroupBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource AppSidebarBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="2" Direction="270" Opacity="0.18" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LargeMetricValuePanelStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,4,8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LargeMetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SevenSegmentMetricValueStyle}">
      <Setter Property="Foreground" Value="{DynamicResource AppMetricValueForegroundBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="LargeMetricUnitStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricUnitStyle}">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Width" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LargeMetricNameStyle" TargetType="TextBlock">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppMetricNameForegroundBrush}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="8,0,10,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="HomeSidebarSubTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#101010" />
      <Setter Property="Height" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="StatusIconStyle" TargetType="iconPacks:PackIconBootstrapIcons">
      <Setter Property="Kind" Value="PatchMinusFill" />
      <Setter Property="Foreground" Value="#909399" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Kind" Value="{DynamicResource AppStatusActiveIconKind}" />
          <Setter Property="Foreground" Value="#2FB344" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HeaderReconnectButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonCustom}">
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="2,0,1,1" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource AppReconnectBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppReconnectBorderBrush}" />
      <Setter Property="ToolTip" Value="重新连接设备主机" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AppReconnectForegroundBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="hc:BorderElement.CornerRadius" Value="4" />
      <Setter Property="hc:BackgroundSwitchElement.MouseHoverBackground" Value="{DynamicResource AppReconnectBackgroundBrush}" />
      <Setter Property="hc:BackgroundSwitchElement.MouseDownBackground" Value="{DynamicResource AppReconnectBackgroundBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AppReconnectHoverForegroundBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AppReconnectPressedForegroundBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="HoldActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
      <Setter Property="Background" Value="#D97706" />
      <Setter Property="BorderBrush" Value="#B45309" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#B45309" />
          <Setter Property="BorderBrush" Value="#92400E" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <hc:DialogContainer>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRowDefinition" Height="39" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.RowSpan="2" hc:Growl.Token="MainGrowl" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,16,16,0" Width="360" Panel.ZIndex="9999" />
      <!-- Header -->
      <Border>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition x:Name="NativeTitleBarRowDefinition" Height="0" />
            <RowDefinition Height="39" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource AppHeaderBackgroundBrush}" IsHitTestVisible="False" />
          <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
            <Image Source="pack://application:,,,/Assets/logo.ico" Width="16" Height="16" Margin="0,0,6,0" />
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Foreground="{DynamicResource AppNavForegroundBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <Grid Grid.Row="0" Grid.ColumnSpan="2" Width="138" HorizontalAlignment="Right" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="46" />
              <ColumnDefinition Width="46" />
              <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AppNavForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AppNavForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AppNavForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource AppHeaderBackgroundBrush}" BorderBrush="{DynamicResource AppHeaderBorderBrush}" BorderThickness="0,0,0,1" />
          <Image x:Name="LogoImage" Grid.RowSpan="2" Source="{DynamicResource AppLogoImageSource}" Stretch="Uniform" Height="36.5" Margin="0,0,30,0" VerticalAlignment="Center" MouseLeftButtonDown="LogoImage_MouseLeftButtonDown" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
          <Grid Grid.RowSpan="2" Grid.Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="90" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource HomeNavButtonStyle}" Click="Home_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconBoxIcons2 Kind="RegularHome" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="主页" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource SettingsNavButtonStyle}" Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconCircumIcons Kind="Settings" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="设置" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource HelpNavButtonStyle}" Click="Help_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconBootstrapIcons Kind="QuestionCircle" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="试验指导" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button x:Name="ColorSchemesButton" Grid.Column="3" Style="{StaticResource ColorSchemesNavButtonStyle}" Visibility="Hidden" Click="ColorSchemes_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconRemixIcon Kind="ColorFilterFill" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="配色" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <Button x:Name="VariablesButton" Grid.Column="4" Style="{StaticResource VariablesNavButtonStyle}" Visibility="Hidden" Click="Variables_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconBootstrapIcons Kind="CardChecklist" Width="18" Height="18" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="变量" Margin="0,2,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
          </Grid>
          <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="104" />
              <ColumnDefinition Width="68" />
              <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ReconnectButton" Grid.Column="1" Style="{StaticResource HeaderReconnectButtonStyle}" Click="Reconnect_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconIonicons Kind="GitNetworkiOS" Width="16" Height="16" Margin="0,0,5,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="重新连接" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
              </StackPanel>
            </Button>
            <TextBlock Grid.Column="2" Text="联机状态" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppConnectionLabelBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,3,0" />
            <Grid Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,6,1">
              <Border Background="{DynamicResource AppConnectionBadgeBackgroundBrush}" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Grid Width="16" Height="16" Margin="0,0,5,0">
                    <iconPacks:PackIconVaadinIcons Kind="GlobeWire" Width="16" Height="16" Foreground="#2FB344" Tag="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState}">
                      <iconPacks:PackIconVaadinIcons.Style>
                        <Style TargetType="iconPacks:PackIconVaadinIcons">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="true">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </iconPacks:PackIconVaadinIcons.Style>
                    </iconPacks:PackIconVaadinIcons>
                    <iconPacks:PackIconPhosphorIcons Kind="GlobeX" Width="16" Height="16" Foreground="#E03131" Tag="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState}">
                      <iconPacks:PackIconPhosphorIcons.Style>
                        <Style TargetType="iconPacks:PackIconPhosphorIcons">
                          <Setter Property="Visibility" Value="Visible" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="true">
                              <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </iconPacks:PackIconPhosphorIcons.Style>
                    </iconPacks:PackIconPhosphorIcons>
                  </Grid>
                  <TextBlock FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="连接失败" />
                        <Setter Property="Foreground" Value="#E03131" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Source={x:Static models:DataAqc.plc}, Path=ConnectState}" Value="true">
                            <Setter Property="Text" Value="已连接" />
                            <Setter Property="Foreground" Value="#2FB344" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      <!-- ==================== HOME PAGE ==================== -->
      <Grid Grid.Row="1">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding CurrentPage}" Value="Home">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="342" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <!-- Left side panel: current trial -->
        <Border Background="{DynamicResource AppSidebarBackgroundBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <StackPanel Margin="12,8,12,8">
              <!-- 当前试验 title -->
              <TextBlock Text="当前试验" Style="{StaticResource HomeSidebarSubTitleStyle}" />
              <!-- Recipe + SN row -->
              <Border Style="{StaticResource CurrentTrialContentBorderStyle}">
                <StackPanel>
              <Grid Height="42" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="*" />
