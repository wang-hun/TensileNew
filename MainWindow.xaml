                  <Button Width="30" Height="26" Padding="0" Margin="6,0,0,0" Click="HelpZoomReset_Click">
                    <iconPacks:PackIconMaterial Kind="ImageFilterCenterFocusStrong" Width="18" Height="18" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="1">
