                  <TextBox x:Name="HelpZoomBox" Width="64" Height="26" Text="100%" FontSize="14" TextAlignment="Center" VerticalContentAlignment="Center" Margin="6,0" LostFocus="HelpZoomBox_LostFocus" KeyDown="HelpZoomBox_KeyDown" />
