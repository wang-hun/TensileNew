                    <iconPacks:PackIconBootstrapIcons Kind="BoxArrowUpRight" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="新窗口打开" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <DataGrid Grid.Row="1" ItemsSource="{Binding PlcVariables}" AutoGenerateColumns="False" IsReadOnly="True" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="变量名称" Binding="{Binding Name}" Width="300" />
                <DataGridTextColumn Header="变量地址" Binding="{Binding Address}" Width="160" />
                <DataGridTextColumn Header="数据类型" Binding="{Binding DataType}" Width="160" />
                <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </hc:DialogContainer>
</Window>
