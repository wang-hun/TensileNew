                  <Button Width="30" Height="26" Padding="0" Margin="6,0,0,0" Click="HelpSearchNext_Click">
                    <iconPacks:PackIconMaterial Kind="ChevronDown" Width="18" Height="18" />
                  </Button>
                  <Button Width="30" Height="26" Padding="0" Margin="12,0,0,0" Click="HelpZoomIn_Click">
