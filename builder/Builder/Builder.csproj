<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ExternalProjectPath Condition="'$(ExternalProjectPath)' == ''">$(MSBuildThisFileDirectory)..\..\TensileNeW.csproj</ExternalProjectPath>
    <ExternalProjectPublishOnBuild Condition="'$(ExternalProjectPublishOnBuild)' == ''">true</ExternalProjectPublishOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ExternalProjectPath)" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PublishExternalProjectToBuilderOutput" AfterTargets="Build" Condition="'$(ExternalProjectPublishOnBuild)' == 'true'">
    <Message Importance="high" Text="Packaging external project '$(ExternalProjectPath)' to '$(TargetDir)publish'." />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; pack &quot;$(ExternalProjectPath)&quot; &quot;$(Configuration)&quot; &quot;$(TargetDir)publish&quot;" />
  </Target>

</Project>
