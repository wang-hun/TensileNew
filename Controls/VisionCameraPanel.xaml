<UserControl x:Class="TensileNeW.Controls.VisionCameraPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource AppHomeCenterBackgroundBrush}">
  <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <ComboBox x:Name="DeviceComboBox" Margin="0,3,8,3" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" />
      <Button Grid.Column="1" Content="&#x5237;&#x65B0;" MinWidth="64" Margin="0,3,6,3" Click="RefreshDevices_Click" />
      <Button x:Name="ConnectButton" Grid.Column="2" Content="&#x8FDE;&#x63A5;&#x76F8;&#x673A;" MinWidth="82" Margin="0,3,8,3" Click="Connect_Click" />
      <TextBlock x:Name="ConnectionStatusText" Grid.Column="3" Text="&#x672A;&#x8FDE;&#x63A5;" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Background="#111827" Margin="0,4,0,8">
      <Grid><Image x:Name="CameraImage" Stretch="Uniform" /><TextBlock x:Name="ImageHintText" Text="&#x8BF7;&#x9009;&#x62E9;&#x5E76;&#x8FDE;&#x63A5;&#x76F8;&#x673A;" Foreground="#D0FFFFFF" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Vertical">
      <WrapPanel VerticalAlignment="Center" Margin="0,0,0,4">
        <TextBlock Text="&#x66DD;&#x5149;" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="ExposureTextBox" Width="86" Height="30" VerticalContentAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Text="&#x589E;&#x76CA;" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="GainTextBox" Width="74" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" />
        <Button Content="&#x8BFB;&#x53D6;" MinWidth="54" Margin="0,0,5,0" Click="ReadParameters_Click" /><Button Content="&#x5E94;&#x7528;" MinWidth="54" Margin="0,0,12,0" Click="ApplyParameters_Click" />
        <TextBlock Text="&#x4FDD;&#x5B58;&#x95F4;&#x9694;(&#x79D2;)" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="IntervalTextBox" Text="1" Width="58" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0" />
        <Button x:Name="StartIntervalButton" Content="&#x5F00;&#x59CB;&#x8FDE;&#x7EED;&#x4FDD;&#x5B58;" Margin="0,0,5,0" Click="StartInterval_Click" /><Button x:Name="StopIntervalButton" Content="&#x7ED3;&#x675F;&#x8FDE;&#x7EED;&#x4FDD;&#x5B58;" IsEnabled="False" Margin="0,0,5,0" Click="StopInterval_Click" /><Button Content="&#x4FDD;&#x5B58;&#x4E00;&#x5F20;" Click="SaveOne_Click" />
      </WrapPanel>
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="&#x56FE;&#x7247;&#x8DEF;&#x5F84;" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBox x:Name="SavePathTextBox" MinWidth="220" Width="340" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,0" /><Button Content="&#x6D4F;&#x89C8;" Margin="0,0,12,0" Click="BrowsePath_Click" />
        <Button x:Name="StartCaptureButton" Content="&#x5F00;&#x59CB;&#x5B9E;&#x65F6;&#x91C7;&#x96C6;" Margin="0,0,5,0" Click="StartCapture_Click" /><Button x:Name="StopCaptureButton" Content="&#x7ED3;&#x675F;&#x5B9E;&#x65F6;&#x91C7;&#x96C6;" IsEnabled="False" Click="StopCapture_Click" />
        <TextBlock x:Name="OperationStatusText" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
