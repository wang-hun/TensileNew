<UserControl x:Class="TensileNeW.Controls.ReportOptionsEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppSidebarBackgroundBrush}"
             FontFamily="Microsoft YaHei">
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="报告编辑" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="管理报告字段的下拉候选项。列表顺序即选择顺序，修改后请点击保存。"
                 FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource AppSidebarLabelForegroundBrush}" />
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Background="{DynamicResource AppSurfaceBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="52" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="报告字段" Margin="18,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 BorderThickness="0" Background="Transparent" Margin="8,0,8,8"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="50" Margin="10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="15" />
                <Border Grid.Column="1" Background="#F0F2F5" BorderBrush="#CDD2DA" BorderThickness="1"
                        Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Options.Count, StringFormat={}{0} 项}" Foreground="#0F5FA8"
                             FontSize="12" FontWeight="Bold" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <Grid Grid.Column="2" Background="{DynamicResource AppSurfaceBackgroundBrush}" DataContext="{Binding}">
        <Grid.RowDefinitions>
          <RowDefinition Height="80" />
          <RowDefinition Height="*" />
          <RowDefinition Height="64" />
          <RowDefinition Height="Auto" MinHeight="52" />
          <RowDefinition Height="Auto" MinHeight="75" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,14,24,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding SelectedGroup.Title}" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SelectedGroup.FieldId, StringFormat=字段标识：{0}}"
                       Margin="14,5,0,0" FontSize="12" Foreground="{DynamicResource AppSidebarLabelForegroundBrush}" />
          </StackPanel>
          <TextBlock Text="{Binding SelectedGroup.Description}" FontSize="13" Margin="0,8,0,0"
                     Foreground="{DynamicResource AppSidebarLabelForegroundBrush}" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedGroup.Options}" BorderThickness="0" Background="Transparent"
                 Margin="16,0,16,4" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" AlternationCount="10000">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Height="52" Margin="4,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" MinWidth="180" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="13"
                           Text="•" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" FontSize="14" Margin="0,4,12,4" MaxLength="200" />
                <Button Grid.Column="2" Content="上移" Margin="2" Height="34" Style="{DynamicResource ActionButtonStyle}"
                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="3" Content="下移" Margin="2" Height="34" Style="{DynamicResource ActionButtonStyle}"
                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="4" Content="删除" Margin="2" Height="34" Style="{StaticResource ButtonDanger}"
                        Command="{Binding DataContext.RemoveOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" Margin="24,4,24,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="160" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding DraftOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                   FontSize="14" VerticalContentAlignment="Center" ToolTip="输入新的备选项" />
          <Button Grid.Column="1" Content="新增选项" Margin="12,0,0,0" Height="40" Style="{DynamicResource ActionButtonStyle}"
                  Command="{Binding AddOptionCommand}" />
        </Grid>
        <WrapPanel Grid.Row="3" Margin="24,4" VerticalAlignment="Center">
          <Button Content="打开文件夹" Width="148" Height="36" Margin="0,0,0,8" Style="{DynamicResource ActionButtonStyle}"
                  ToolTip="打开 ReportOptions.json 所在的程序目录" Click="OpenFolder_Click" />
          <Button Content="导入选项" Width="128" Height="36" Margin="8,0,0,8" Style="{DynamicResource ActionButtonStyle}"
                  ToolTip="从 JSON 文件替换当前列表；点击保存后才会写入程序配置" Click="Import_Click" />
          <Button Content="导出选项" Width="128" Height="36" Margin="8,0,0,8" Style="{DynamicResource ActionButtonStyle}"
                  ToolTip="将当前列表（包括尚未保存的编辑）导出为 JSON 文件" Click="Export_Click" />
        </WrapPanel>
        <Grid Grid.Row="4" Margin="24,8,24,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="130" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource AppSidebarLabelForegroundBrush}" />
            <TextBlock Text="{Binding FilePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding FilePath}" Foreground="{DynamicResource AppSidebarLabelForegroundBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Content="保存选项" Height="42" Style="{StaticResource ButtonPrimary}"
                  Command="{Binding SaveCommand}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
