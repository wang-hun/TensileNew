<UserControl x:Class="TensileNeW.ConnectionErrorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="460"
             Background="{DynamicResource AppConnectionErrorBackgroundBrush}"
             FontFamily="Microsoft YaHei">
    <UserControl.Resources>
        <Style x:Key="NetworkProbeButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Background" Value="#2FB344" />
            <Setter Property="BorderBrush" Value="#2A9D3F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="hc:BackgroundSwitchElement.MouseHoverBackground" Value="#37C352" />
            <Setter Property="hc:BackgroundSwitchElement.MouseDownBackground" Value="#258F38" />
        </Style>
    </UserControl.Resources>

    <Border Padding="28" Background="{DynamicResource AppConnectionErrorBackgroundBrush}" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <iconPacks:PackIconBootstrapIcons Grid.RowSpan="2"
                                              Kind="WrenchAdjustableCircleFill"
                                              Width="42"
                                              Height="42"
                                              Foreground="#D03050"
                                              VerticalAlignment="Top"
                                              Margin="0,2,18,0" />

            <TextBlock Grid.Column="1"
                       Text="连接失败"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppConnectionErrorForegroundBrush}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="请检查线路！"
                       FontSize="17"
                       Foreground="{DynamicResource AppConnectionErrorForegroundBrush}"
                       Margin="0,10,0,24" />
            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource NetworkProbeButtonStyle}"
                        Content="尝试网络检查"
                        Width="132"
                        Height="36"
                        Margin="0,0,12,0"
                        Click="NetworkProbe_Click" />
                <Button Style="{StaticResource ButtonPrimary}"
                        Content="关闭"
                        Width="96"
                        Height="36"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
