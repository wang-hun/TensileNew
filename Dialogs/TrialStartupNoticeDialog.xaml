<UserControl x:Class="TensileNeW.TrialStartupNoticeDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460"
             Background="{DynamicResource AppSurfaceBackgroundBrush}"
             FontFamily="Microsoft YaHei">
    <Border Padding="28"
            Background="{DynamicResource AppSurfaceBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="试用版"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontSize="17"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                       Margin="0,12,0,24" />
            <Button Grid.Row="2"
                    Style="{StaticResource ButtonPrimary}"
                    Content="知道了"
                    Width="96"
                    Height="36"
                    HorizontalAlignment="Center"
                    Click="Confirm_Click" />
        </Grid>
    </Border>
</UserControl>
