<Window x:Class="TensileNeW.CurveFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="筛选曲线"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceBackgroundBrush}"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <PathGeometry x:Key="RightTopLongBaseAnimationGeometry">
            <PathFigure StartPoint="514,18" IsClosed="False">
                <LineSegment Point="44,18" />
            </PathFigure>
        </PathGeometry>
        <PathGeometry x:Key="LeftBottomLongBaseAnimationGeometry">
            <PathFigure StartPoint="105,602" IsClosed="False">
                <LineSegment Point="576,602" />
            </PathFigure>
        </PathGeometry>

        <Style x:Key="CurveFilterRowBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#FBE3E3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                    <Setter Property="Background" Value="#DFF3E4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBackgroundBrush}"
                BorderThickness="0"
                CornerRadius="4">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="筛选曲线"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,18" />

                <Grid Grid.Row="1"
                      Height="30"
                      Margin="0,0,0,8"
                      TextElement.Foreground="{DynamicResource AppMetricNameForegroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="显示"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="序列号"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="试验开始时间"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Grid>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Rows}"
                         Height="374"
                         BorderThickness="0"
                         Background="{DynamicResource AppHomeCenterBackgroundBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CurveFilterRowBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TrialSerialNumber}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StartedAtText}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <Button Style="{StaticResource ButtonPrimary}"
                            Width="96"
                            Height="36"
                            Margin="0,0,12,0"
                            Content="确定"
                            Click="Ok_Click" />
                    <Button Style="{StaticResource ButtonDanger}"
                            Width="96"
                            Height="36"
                            Content="取消"
                            Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid IsHitTestVisible="False">
            <Rectangle Width="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Margin="18,0,0,0"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Rectangle Width="44"
                       Height="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,18,0,0"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Canvas Width="150"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <Path Data="M 131,0 L 74,0 L 44,18 L 131,18"
                      Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                      StrokeThickness="1"
                      Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            </Canvas>
            <Rectangle Width="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       Margin="0,0,18,0"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Rectangle Width="44"
                       Height="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,18"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Canvas Width="150"
                    Height="22"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                <Path Data="M 18,22 L 75,22 L 105,4 L 18,4"
                      Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                      StrokeThickness="1"
                      Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            </Canvas>
            <Canvas Width="620"
                    Height="620"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <hc:AnimationPath Data="{StaticResource RightTopLongBaseAnimationGeometry}"
                                  Width="620"
                                  Height="620"
                                  Duration="00:00:02"
                                  PathLength="30"
                                  Stretch="None"
                                  StrokeThickness="1"
                                  Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                                  StrokeStartLineCap="Flat"
                                  StrokeEndLineCap="Flat" />
                <hc:AnimationPath Data="{StaticResource LeftBottomLongBaseAnimationGeometry}"
                                  Width="620"
                                  Height="620"
                                  Duration="00:00:02"
                                  PathLength="30"
                                  Stretch="None"
                                  StrokeThickness="1"
                                  Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                                  StrokeStartLineCap="Flat"
                                  StrokeEndLineCap="Flat" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
