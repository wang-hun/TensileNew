<Window x:Class="TensileNeW.CameraPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="摄像头预览"
        Width="900"
        Height="620"
        MinWidth="420"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AppSurfaceBackgroundBrush}"
        FontFamily="Microsoft YaHei">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource AppSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource AppLayoutBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{DynamicResource AppHeaderBackgroundBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MaximizeButton"
                        Grid.Column="1"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTip="最大化"
                        Click="Maximize_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <iconPacks:PackIconMaterial x:Name="MaximizeIcon"
                                                Kind="WindowMaximize"
                                                Width="14"
                                                Height="14"
                                                Foreground="{DynamicResource AppNavForegroundBrush}" />
                </Button>
                <Button Grid.Column="2"
                        Width="32"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTip="关闭"
                        Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Width="14"
                                                Height="14"
                                                Foreground="{DynamicResource AppNavForegroundBrush}" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Background="Black">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       SizeChanged="PreviewImage_SizeChanged" />
                <TextBlock x:Name="EmptyTextBlock"
                           Text="摄像头未连接"
                           Foreground="#D0FFFFFF"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
