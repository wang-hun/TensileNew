<Window x:Class="TensileNeW.ReportPreviewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="报告预览与填写"
        Width="1180"
        Height="820"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBackgroundBrush}"
        FontFamily="Microsoft YaHei">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.RowSpan="3" hc:Growl.Token="ReportPreviewGrowl"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Width="340" Panel.ZIndex="10" IsHitTestVisible="False" />
        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="报告预览与填写"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PageCountText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                           Margin="0,0,12,0" />
                <Button Content="−"
                        Width="34"
                        Height="32"
                        Margin="0,0,4,0"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="缩小"
                        Click="ZoomOut_Click" />
                <TextBlock x:Name="ZoomLevelText"
                           Width="52"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
                <Button Content="+"
                        Width="34"
                        Height="32"
                        Margin="4,0,8,0"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="放大"
                        Click="ZoomIn_Click" />
                <Button Content="适合宽度"
                        MinWidth="88"
                        Height="32"
                        Padding="8,0"
                        Style="{StaticResource ButtonPrimary}"
                        ToolTip="自动适配预览区域宽度"
                        Click="FitWidth_Click" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageStackPanel"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="96"
                        Height="36"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="确认并保存"
                        Style="{StaticResource ButtonPrimary}"
                        MinWidth="120"
                        Height="36"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>