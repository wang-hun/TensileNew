<Window x:Class="TensileNeW.ReportPreviewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报告预览与编辑"
        Width="1100"
        Height="760"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBackgroundBrush}"
        FontFamily="Microsoft YaHei">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="报告预览与编辑"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <TextBlock x:Name="SheetNameText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                       Margin="16,0,0,0" />
        </DockPanel>
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="White">
            <ContentControl x:Name="TemplateHost" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
        <Button Grid.Row="2"
                Content="关闭"
                Style="{StaticResource ButtonPrimary}"
                Width="96"
                Height="36"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsCancel="True" />
    </Grid>
</Window>