<Window x:Class="TensileNeW.ReportPreviewEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报告预览与填写"
        Width="1180"
        Height="820"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurfaceBackgroundBrush}"
        FontFamily="Microsoft YaHei">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="报告预览与填写"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <TextBlock x:Name="PageCountText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                       Margin="16,0,0,0" />
        </DockPanel>
        <ScrollViewer x:Name="PageScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel x:Name="PageStackPanel"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12" />
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ValidationText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="96"
                        Height="36"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Content="确认并保存"
                        Style="{StaticResource ButtonPrimary}"
                        MinWidth="120"
                        Height="36"
                        IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>