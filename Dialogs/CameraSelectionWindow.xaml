<UserControl x:Class="TensileNeW.CameraSelectionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="560"
             Background="{DynamicResource AppConnectionErrorBackgroundBrush}"
             FontFamily="Microsoft YaHei"
             Unloaded="UserControl_Unloaded">
    <Border Padding="28" Background="{DynamicResource AppConnectionErrorBackgroundBrush}" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="180" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <iconPacks:PackIconBootstrapIcons Grid.RowSpan="2"
                                              Kind="CameraVideoFill"
                                              Width="42"
                                              Height="42"
                                              Foreground="#1677FF"
                                              VerticalAlignment="Top"
                                              Margin="0,2,18,0" />

            <TextBlock Grid.Column="1"
                       Text="选择摄像头"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppConnectionErrorForegroundBrush}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="请选择本次试验使用的摄像头。"
                       FontSize="17"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppConnectionErrorForegroundBrush}"
                       Margin="0,10,0,18" />
            <ComboBox x:Name="CameraComboBox"
                      Grid.Row="2"
                      Grid.Column="1"
                      DisplayMemberPath="Name"
                      Height="34"
                      FontSize="15"
                      Background="{DynamicResource AppSurfaceBackgroundBrush}"
                      SelectionChanged="CameraComboBox_SelectionChanged" />
            <Border Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,14,0,0"
                    Background="Black"
                    BorderBrush="{DynamicResource AppLayoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           SizeChanged="PreviewImage_SizeChanged" />
                    <TextBlock x:Name="PreviewEmptyTextBlock"
                               Text="正在准备预览"
                               Foreground="#D0FFFFFF"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Style="{StaticResource ButtonPrimary}"
                        Content="确定"
                        Width="96"
                        Height="36"
                        Margin="0,0,10,0"
                        Click="Ok_Click" />
                <Button Content="取消"
                        Width="96"
                        Height="36"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
