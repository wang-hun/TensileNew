<Window x:Class="TensileNeW.SingleInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Width="520" Height="260" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="{DynamicResource AppStartupWaitBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <PathGeometry x:Key="HexagonGeometry">
            <PathFigure StartPoint="42.2, 9.5" IsClosed="False">
                <LineSegment Point="11,27.5" />
                <LineSegment Point="11,72.5" />
                <LineSegment Point="50,95" />
                <LineSegment Point="89,72.5" />
                <LineSegment Point="50,50" />
                <LineSegment Point="50,45" />
                <LineSegment Point="50,55" />
                <LineSegment Point="50,50" />
                <LineSegment Point="89,27.5" />
                <LineSegment Point="57.8, 9.5" />
            </PathFigure>
        </PathGeometry>

        <Style x:Key="DialogCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#D03050" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogConfirmButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppStartupWaitAccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppStartupWaitForegroundBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderThickness="0" Background="{DynamicResource AppStartupWaitBackgroundBrush}">
        <Grid>
            <Button Content="×"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource DialogCloseButtonStyle}"
                    Click="CloseButton_Click" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,18,22,22">
                <Grid Width="82" Height="82" Margin="0,0,0,22">
                    <hc:AnimationPath Data="{StaticResource HexagonGeometry}"
                                      Duration="00:00:01.4"
                                      Stretch="Uniform"
                                      StrokeThickness="4"
                                      Stroke="{DynamicResource AppStartupWaitAccentBrush}"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat" />
                </Grid>
                <TextBlock Text="ECS已经在运行"
                           FontSize="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource AppStartupWaitForegroundBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />
                <Button Content="确定"
                        Style="{StaticResource DialogConfirmButtonStyle}"
                        Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
