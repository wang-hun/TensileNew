<Window x:Class="TensileNeW.StartupWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Width="520" Height="220" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="{DynamicResource AppStartupWaitBackgroundBrush}" ShowInTaskbar="False">
    <Window.Resources>
        <PathGeometry x:Key="HexagonGeometry">
            <PathFigure StartPoint="42.2, 9.5" IsClosed="False">
                <LineSegment Point="11,27.5" />
                <LineSegment Point="11,72.5" />
                <LineSegment Point="50,95" />
                <LineSegment Point="89,72.5" />
                <LineSegment Point="50,50" />
                <LineSegment Point="50,45" />
                <LineSegment Point="50,55" />
                <LineSegment Point="50,50" />
                <LineSegment Point="89,27.5" />
                <LineSegment Point="57.8, 9.5" />
            </PathFigure>
        </PathGeometry>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource AppStartupWaitBorderBrush}" BorderThickness="1" Background="{DynamicResource AppStartupWaitBackgroundBrush}">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HintTextBlock"
                       Grid.Row="0"
                       Text="第一次运行程序可能需要比较长的时间。"
                       FontSize="14"
                       Foreground="{DynamicResource AppStartupWaitForegroundBrush}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="82" Height="82" Margin="0,0,0,22">
                    <hc:AnimationPath Data="{StaticResource HexagonGeometry}"
                                      Duration="00:00:01.4"
                                      Stretch="Uniform"
                                      StrokeThickness="4"
                                      Stroke="#FFDD00"
                                      StrokeStartLineCap="Flat"
                                      StrokeEndLineCap="Flat" />
                </Grid>
                <TextBlock x:Name="WaitTextBlock"
                           FontSize="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="{DynamicResource AppStartupWaitForegroundBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
