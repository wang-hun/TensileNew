<Window x:Class="TensileNeW.ChartSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Width="420"
        Height="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Microsoft YaHei">
    <Window.Resources>
        <PathGeometry x:Key="RightTopLongBaseAnimationGeometry">
            <PathFigure StartPoint="314,18" IsClosed="False">
                <LineSegment Point="44,18" />
            </PathFigure>
        </PathGeometry>
        <PathGeometry x:Key="LeftBottomLongBaseAnimationGeometry">
            <PathFigure StartPoint="105,362" IsClosed="False">
                <LineSegment Point="376,362" />
            </PathFigure>
        </PathGeometry>

        <Style x:Key="TextLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppMetricValueForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border Background="{DynamicResource AppSurfaceBackgroundBrush}"
                BorderThickness="0"
                CornerRadius="4">
            <Grid Margin="22,42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTip="关闭"
                        Click="Close_Click">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Width="20"
                                                Height="20"
                                                Foreground="{DynamicResource AppConnectionErrorForegroundBrush}" />
                </Button>

                <TextBlock Grid.Row="1"
                           Text="设置"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />

                <StackPanel Grid.Row="2"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            TextElement.Foreground="{DynamicResource AppMetricNameForegroundBrush}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                        <CheckBox Content="自动播放曲线图"
                                  IsChecked="{Binding AutoTrackLatestPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="16"
                                  Checked="SettingCheckBox_Changed"
                                  Unchecked="SettingCheckBox_Changed" />
                        <Border Width="48"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="勾选后，采集过程中曲线图会自动缩放到当前数据。">
                            <iconPacks:PackIconPhosphorIcons Kind="QuestionBold"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AppMetricValueForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                        <CheckBox Content="是否显示图例"
                                  IsChecked="{Binding ShowPlotLegend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="16"
                                  Checked="SettingCheckBox_Changed"
                                  Unchecked="SettingCheckBox_Changed" />
                        <Border Width="48"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="勾选后，曲线图会显示各条曲线对应的序列号。">
                            <iconPacks:PackIconPhosphorIcons Kind="QuestionBold"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AppMetricValueForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16">
                        <CheckBox Content="重置数据时保留曲线"
                                  IsChecked="{Binding KeepPlotOnReset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="16"
                                  Checked="SettingCheckBox_Changed"
                                  Unchecked="SettingCheckBox_Changed" />
                        <Border Width="48"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="勾选后，重置数据时保留已有曲线，下一次试验会使用新颜色绘制新曲线。">
                            <iconPacks:PackIconPhosphorIcons Kind="QuestionBold"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AppMetricValueForegroundBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">
                        <Button Style="{StaticResource TextLinkButtonStyle}"
                                Margin="22,0,0,0"
                                HorizontalAlignment="Left"
                                FontSize="16"
                                Click="ResetSerial_Click"
                                Content="重置序列号" />
                        <Border Width="48"
                                Height="16"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ToolTip="确认后将序列号重置为 00001，只影响下一次开始的试验。">
                            <iconPacks:PackIconPhosphorIcons Kind="QuestionBold"
                                                             Width="16"
                                                             Height="16"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{DynamicResource AppMetricValueForegroundBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="3"
                        Style="{StaticResource ButtonPrimary}"
                        Width="96"
                        Height="36"
                        HorizontalAlignment="Center"
                        Content="确定"
                        Click="Ok_Click" />
            </Grid>
        </Border>

        <Grid IsHitTestVisible="False">
            <Rectangle Width="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Margin="18,0,0,0"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Rectangle Width="44"
                       Height="1"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="0,18,0,0"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Canvas Width="150"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
                <Path Data="M 131,0 L 74,0 L 44,18 L 131,18"
                      Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                      StrokeThickness="1"
                      Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            </Canvas>
            <Rectangle Width="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Stretch"
                       Margin="0,0,18,0"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Rectangle Width="44"
                       Height="1"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,18"
                       Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            <Canvas Width="150"
                    Height="22"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom">
                <Path Data="M 18,22 L 75,22 L 105,4 L 18,4"
                      Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                      StrokeThickness="1"
                      Fill="{DynamicResource AppMetricValueForegroundBrush}" />
            </Canvas>
            <Canvas Width="420"
                    Height="380"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <hc:AnimationPath Data="{StaticResource RightTopLongBaseAnimationGeometry}"
                                  Width="420"
                                  Height="380"
                                  Duration="00:00:02"
                                  PathLength="30"
                                  Stretch="None"
                                  StrokeThickness="1"
                                  Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                                  StrokeStartLineCap="Flat"
                                  StrokeEndLineCap="Flat" />
                <hc:AnimationPath Data="{StaticResource LeftBottomLongBaseAnimationGeometry}"
                                  Width="420"
                                  Height="380"
                                  Duration="00:00:02"
                                  PathLength="30"
                                  Stretch="None"
                                  StrokeThickness="1"
                                  Stroke="{DynamicResource AppMetricValueForegroundBrush}"
                                  StrokeStartLineCap="Flat"
                                  StrokeEndLineCap="Flat" />
            </Canvas>
        </Grid>
    </Grid>
</Window>
