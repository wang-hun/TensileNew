<Window x:Class="TensileNeW.LoadDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TensileNeW"
        Title="数据表格"
        Width="760"
        Height="620"
        MinWidth="520"
        MinHeight="360"
        Background="{DynamicResource AppSidebarBackgroundBrush}"
        FontFamily="Microsoft YaHei"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:FloatFormatConverter x:Key="FloatFormat" />
    </Window.Resources>
    <Border BorderBrush="{DynamicResource AppLayoutBorderBrush}" BorderThickness="1" Background="{DynamicResource AppSidebarBackgroundBrush}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource AppSurfaceBackgroundBrush}" BorderBrush="{DynamicResource AppLayoutBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <CheckBox x:Name="LoadDataAutoScrollCheckBox" Content="自动滚动到最新行" IsChecked="True" FontSize="14" Foreground="{DynamicResource AppMetricNameForegroundBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <TextBlock Text="数据表格"
                               Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
            <DataGrid x:Name="LoadDataGrid"
                      Grid.Row="1"
                      ItemsSource="{Binding LoadItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="10"
                      RowHeaderWidth="0"
                      Background="{DynamicResource AppSidebarBackgroundBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="*" />
                    <DataGridTextColumn Header="位移(mm)" Binding="{Binding RealDistance, Converter={StaticResource FloatFormat}}" Width="*" />
                    <DataGridTextColumn Header="力(kN)" Binding="{Binding RealForce, Converter={StaticResource FloatFormat}}" Width="*" />
                    <DataGridTextColumn Header="压边(kN)" Binding="{Binding RealPress, Converter={StaticResource FloatFormat}}" Width="*" />
                    <DataGridTextColumn Header="时间(s)" Binding="{Binding Time}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
