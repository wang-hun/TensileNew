<Window x:Class="TensileNeW.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="200" WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        Background="{DynamicResource AppSurfaceBackgroundBrush}" FontFamily="Microsoft YaHei"
        Title="请输入" ShowInTaskbar="False">
    <Grid Margin="20" Background="{DynamicResource AppSurfaceBackgroundBrush}" TextElement.Foreground="{DynamicResource AppMetricNameForegroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontSize="16" Margin="0,0,0,10" />
        <TextBox Grid.Row="1" x:Name="InputBox" FontSize="18" VerticalContentAlignment="Center"
                 Height="40" Padding="6,0" KeyDown="InputBox_KeyDown" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="90" Height="36" FontSize="14" Margin="0,0,8,0"
                    IsDefault="True" Click="Ok_Click" />
            <Button Content="取消" Width="90" Height="36" FontSize="14"
                    IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
