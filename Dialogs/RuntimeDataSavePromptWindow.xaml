<Window x:Class="TensileNeW.RuntimeDataSavePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="保存运行数据"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource AppSurfaceBackgroundBrush}"
        FontFamily="Microsoft YaHei">
    <Border Background="{DynamicResource AppSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource AppLayoutBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource AppSidebarBackgroundBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        ToolTip="取消关闭"
                        Click="Close_Click">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Width="18"
                                                Height="18"
                                                Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
                </Button>
            </Grid>

            <TextBlock Grid.Row="1"
                       Text="是否保存当前所有试验的运行数据，以供后续数据分析？"
                       FontSize="17"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="24,22,24,0"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />

            <CheckBox x:Name="DontAskAgainCheckBox"
                      Grid.Row="2"
                      Content="下次不再提醒"
                      IsChecked="False"
                      FontSize="14"
                      Margin="24,18,24,0"
                      Foreground="{DynamicResource AppMetricNameForegroundBrush}" />

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,24,24,24">
                <Button Style="{StaticResource ButtonPrimary}"
                        Content="是"
                        Width="88"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="Yes_Click" />
                <Button Style="{StaticResource ButtonDanger}"
                        Content="否"
                        Width="88"
                        Height="34"
                        Click="No_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
