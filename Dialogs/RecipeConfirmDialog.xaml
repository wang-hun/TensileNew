<UserControl x:Class="TensileNeW.RecipeConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420"
             Background="White"
             FontFamily="Microsoft YaHei">
    <Border Padding="24" Background="White" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="确认是否删除当前试验？"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#303133" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Style="{StaticResource ButtonDanger}"
                        Content="删除"
                        Width="88"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="Ok_Click" />
                <Button Content="取消"
                        Width="88"
                        Height="34"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
