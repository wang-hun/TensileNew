<UserControl x:Class="TensileNeW.AnnotationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500"
             Background="Transparent"
             FontFamily="Microsoft YaHei">
    <Border Background="{DynamicResource AppSurfaceBackgroundBrush}"
            CornerRadius="8"
            ClipToBounds="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="批注名称"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
        <TextBlock Grid.Row="1"
                   Text="保存时将作为文件名的一部分。"
                   FontSize="13"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
        <TextBox Grid.Row="2"
                 x:Name="AnnotationNameTextBox"
                 Height="34"
                 Margin="0,8,0,0"
                 Padding="8,0"
                 FontSize="16"
                 Foreground="{DynamicResource AppSidebarLabelForegroundBrush}"
                 Background="{DynamicResource AppSurfaceBackgroundBrush}"
                 BorderBrush="#1F1F1F"
                 BorderThickness="1"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="3"
                   Text="批注内容"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,18,0,0"
                   Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="92" />
            </Grid.RowDefinitions>
            <TextBlock Text="保存时将写入试验报告。"
                       FontSize="13"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />
            <RichTextBox Grid.Row="1"
                         x:Name="AnnotationContentTextBox"
                         Padding="8,0"
                         FontSize="16"
                         Foreground="{DynamicResource AppSidebarLabelForegroundBrush}"
                         Background="{DynamicResource AppSurfaceBackgroundBrush}"
                         BorderBrush="#1F1F1F"
                         BorderThickness="1"
                         VerticalScrollBarVisibility="Auto">
                <FlowDocument PagePadding="0"
                              LineHeight="22"
                              LineStackingStrategy="BlockLineHeight">
                    <FlowDocument.Resources>
                        <Style TargetType="{x:Type Paragraph}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="LineHeight" Value="22" />
                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                        </Style>
                    </FlowDocument.Resources>
                </FlowDocument>
            </RichTextBox>
        </Grid>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button Style="{StaticResource ButtonPrimary}"
                    Content="保存"
                    Width="88"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="Save_Click" />
            <Button Content="取消"
                    Width="88"
                    Height="34"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
