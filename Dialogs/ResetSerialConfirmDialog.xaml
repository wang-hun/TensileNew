<UserControl x:Class="TensileNeW.ResetSerialConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420"
             Background="{DynamicResource AppSurfaceBackgroundBrush}"
             FontFamily="Microsoft YaHei">
    <Border Padding="24"
            Background="{DynamicResource AppSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource AppLayoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="确认重置序列号？"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />

            <TextBlock Grid.Row="1"
                       Margin="0,12,0,0"
                       Text="这只影响下一次开始的试验。"
                       FontSize="14"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Style="{StaticResource ButtonPrimary}"
                        Content="确定"
                        Width="88"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="Ok_Click" />
                <Button Content="取消"
                        Width="88"
                        Height="34"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
