<UserControl x:Class="TensileNeW.RecipeNameDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520"
             Background="{DynamicResource AppSurfaceBackgroundBrush}"
             FontFamily="Microsoft YaHei">
    <Border Padding="24"
            Background="{DynamicResource AppSurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource AppLayoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="请输入配方名称："
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppMetricNameForegroundBrush}" />

            <TextBox Grid.Row="1"
                     x:Name="InputBox"
                     Height="38"
                     FontSize="16"
                     Margin="0,14,0,0"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown" />

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="复制默认模版"
                           FontSize="15"
                           Foreground="{DynamicResource AppMetricNameForegroundBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,10,0" />
                <ComboBox Grid.Column="1"
                          x:Name="TemplateComboBox"
                          Height="34"
                          FontSize="15"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="TemplateComboBox_SelectionChanged" />
            </Grid>

            <Border Grid.Row="3"
                    x:Name="TemplatePreviewBorder"
                    Margin="0,16,0,0"
                    Padding="12"
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource AppLayoutBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <Grid TextElement.Foreground="{DynamicResource AppMetricNameForegroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StrokeForcePreviewText" Grid.Row="0" Grid.Column="0" FontSize="14" Margin="0,0,14,8" />
                    <TextBlock x:Name="ClosedLoopPreviewText" Grid.Row="0" Grid.Column="1" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock x:Name="ShutdownDelayPreviewText" Grid.Row="1" Grid.Column="0" FontSize="14" Margin="0,0,14,8" />
                    <TextBlock x:Name="ShutdownRatioPreviewText" Grid.Row="1" Grid.Column="1" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock x:Name="SpeedPreviewText" Grid.Row="2" Grid.Column="0" FontSize="14" Margin="0,0,14,8" />
                    <TextBlock x:Name="DistanceLimitPreviewText" Grid.Row="2" Grid.Column="1" FontSize="14" Margin="0,0,0,8" />
                    <TextBlock x:Name="TemplateNamePreviewText" Grid.Row="3" Grid.ColumnSpan="2" FontSize="14" FontWeight="Bold" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button Style="{StaticResource ButtonPrimary}"
                        Content="确定"
                        Width="88"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="Ok_Click" />
                <Button Content="取消"
                        Width="88"
                        Height="34"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
