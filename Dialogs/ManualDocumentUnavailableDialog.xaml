<UserControl x:Class="TensileNeW.ManualDocumentUnavailableDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Width="520"
             Background="{DynamicResource AppConnectionErrorBackgroundBrush}"
             FontFamily="Microsoft YaHei">
    <Border Padding="28" Background="{DynamicResource AppConnectionErrorBackgroundBrush}" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <iconPacks:PackIconBootstrapIcons Grid.RowSpan="2"
                                              Kind="ExclamationTriangleFill"
                                              Width="42"
                                              Height="42"
                                              Foreground="#D03050"
                                              VerticalAlignment="Top"
                                              Margin="0,2,18,0" />

            <TextBlock Grid.Column="1"
                       Text="说明文档不可用"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppConnectionErrorForegroundBrush}" />
            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       Text="未安装office或者wps，试验说明文档无法使用。"
                       FontSize="17"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppConnectionErrorForegroundBrush}"
                       Margin="0,10,0,24" />
            <Button Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource ButtonPrimary}"
                    Content="确定"
                    Width="96"
                    Height="36"
                    HorizontalAlignment="Right"
                    Click="Close_Click" />
        </Grid>
    </Border>
</UserControl>
