<Window x:Class="TensileNeW.PlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="曲线图"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        Background="{DynamicResource AppHomeCenterBackgroundBrush}"
        FontFamily="Microsoft YaHei"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <sp:WpfPlot x:Name="PlotHost" Margin="8" Background="{DynamicResource AppSurfaceBackgroundBrush}" />
    </Grid>
</Window>
