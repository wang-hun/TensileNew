<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ECS</AssemblyName>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.14393.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Version>2.1.4.2608</Version>
    <AssemblyVersion>2.1.4.2608</AssemblyVersion>
    <FileVersion>2.1.4.2608</FileVersion>
    <InformationalVersion>V2.1.4.2608</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="builder\**" />
    <Compile Remove="bin\**" />
    <Compile Remove="codex_obj\**" />
    <Compile Remove="demo\**" />
    <Compile Remove="helper\**" />
    <Compile Remove="installer\**" />
    <Compile Remove="obj\**" />
    <Compile Remove="SamplingCapture\**" />
    <EmbeddedResource Remove="builder\**" />
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="codex_obj\**" />
    <EmbeddedResource Remove="demo\**" />
    <EmbeddedResource Remove="helper\**" />
    <EmbeddedResource Remove="installer\**" />
    <EmbeddedResource Remove="obj\**" />
    <EmbeddedResource Remove="SamplingCapture\**" />
    <None Remove="builder\**" />
    <None Remove="bin\**" />
    <None Remove="codex_obj\**" />
    <None Remove="demo\**" />
    <None Remove="helper\**" />
    <None Remove="installer\**" />
    <None Remove="obj\**" />
    <None Remove="SamplingCapture\**" />
    <Page Remove="builder\**" />
    <Page Remove="bin\**" />
    <Page Remove="codex_obj\**" />
    <Page Remove="demo\**" />
    <Page Remove="helper\**" />
    <Page Remove="installer\**" />
    <Page Remove="obj\**" />
    <Page Remove="SamplingCapture\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tools\DeltaPlcController .cs" />
    <Compile Remove="Tools\Converter\BindingHelper.cs" />
    <Compile Remove="Tools\Converter\IValueConverter.cs" />
    <Compile Remove="Tools\Converter\IntegerToUnitStringConverter.cs" />
    <Compile Remove="Tools\Converter\StringToStateConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="EPPlus" Version="4.5.3.3" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Haukcode.HighResolutionTimer" Version="1.2.0" />
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="4.7.15" />
    <PackageReference Include="NModbus" Version="3.0.81" />
    <PackageReference Include="NPOI" Version="2.7.3" />
    <PackageReference Include="PdfiumViewer" Version="2.13.0" />
    <PackageReference Include="PdfiumViewer.Native.x86.v8-xfa" Version="2018.4.8.256" GeneratePathProperty="true" />
    <PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" GeneratePathProperty="true" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.58" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GB-LOGO.png" />
    <Resource Include="Assets\GB-LOGO_BLUE.png" />
    <Resource Include="Assets\logo.ico" />
    <None Update="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\DefaultRecipe.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Seven Segment.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPdfiumNativeToOutputDirectory" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)x86" />
    <MakeDir Directories="$(OutDir)x64" />
    <Copy SourceFiles="$(NuGetPackageRoot)pdfiumviewer.native.x86.v8-xfa\2018.4.8.256\Build\x86\pdfium.dll" DestinationFiles="$(OutDir)x86\pdfium.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" DestinationFiles="$(OutDir)x64\pdfium.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPdfiumNativeToPublishDirectory" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)x86" />
    <MakeDir Directories="$(PublishDir)x64" />
    <Copy SourceFiles="$(NuGetPackageRoot)pdfiumviewer.native.x86.v8-xfa\2018.4.8.256\Build\x86\pdfium.dll" DestinationFiles="$(PublishDir)x86\pdfium.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(NuGetPackageRoot)pdfiumviewer.native.x86_64.v8-xfa\2018.4.8.256\Build\x64\pdfium.dll" DestinationFiles="$(PublishDir)x64\pdfium.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
