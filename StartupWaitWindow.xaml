<Window x:Class="TensileNeW.StartupWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Width="440" Height="190" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="White" ShowInTaskbar="False">
    <Border BorderBrush="#D8DBE3" BorderThickness="1" Background="White">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <hc:LoadingCircle Width="54" Height="54" Margin="0,0,0,20" />
            <TextBlock x:Name="WaitTextBlock" FontSize="20" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
