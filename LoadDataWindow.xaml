<Window x:Class="TensileNeW.LoadDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TensileNeW"
        Title="数据表格"
        Width="760"
        Height="620"
        MinWidth="520"
        MinHeight="360"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <local:FloatFormatConverter x:Key="FloatFormat" />
    </Window.Resources>
    <Border BorderBrush="#C0C4CC" BorderThickness="1" Background="White" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="#F5F6F8" BorderBrush="#D8DBE3" BorderThickness="0,0,0,1">
                <TextBlock Text="数据表格"
                           Foreground="#404040"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding LoadItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="10"
                      RowHeaderWidth="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="90" />
                    <DataGridTextColumn Header="位移" Binding="{Binding RealDistance, Converter={StaticResource FloatFormat}}" Width="120" />
                    <DataGridTextColumn Header="载荷" Binding="{Binding RealForce, Converter={StaticResource FloatFormat}}" Width="120" />
                    <DataGridTextColumn Header="压边" Binding="{Binding RealPress, Converter={StaticResource FloatFormat}}" Width="120" />
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="*" MinWidth="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
